# Merge this BGP section into prefixd.yaml; keep the other required settings.
bgp:
  backend: rustbgpd
  local_asn: 64500
  router_id: 192.0.2.1
  rustbgpd:
    endpoint: "unix:///run/rustbgpd/grpc.sock"
    leased_flowspec: true
  default_scope:
    ipv4: TRANSIT
    ipv6: TRANSIT6
  vpn_scopes:
    TRANSIT:
      family: ipv4
      rd: "64500:40"
      route_targets: ["64500:777"]
      allow_source_only: false
    TRANSIT6:
      family: ipv6
      rd: "64500:40"
      route_targets: ["64500:777"]
      allow_source_only: false
