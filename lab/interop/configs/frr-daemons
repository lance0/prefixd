# Copied from rustbgpd tests/interop/configs/frr-daemons (M22 FlowSpec lab).
bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
staticd=yes
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no
# Loads the RPKI module; it validates nothing until the blackhole scenario's
# RPKI step configures a cache.
bgpd_options="   -A 127.0.0.1 -M rpki"
