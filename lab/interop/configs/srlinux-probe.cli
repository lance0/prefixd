# SR Linux side of the FlowSpec probe: one eBGP session to rustbgpd with IPv4
# unicast only. The probe then tries to enable FlowSpec families interactively.
# Keep comments free of apostrophes and quotes: sr_cli batch input treats an
# unbalanced quote as an open string (lesson recorded by rustbgpd M82).
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.0.0.2/24
set / network-instance default interface ethernet-1/1.0
set / network-instance default protocols bgp autonomous-system 65002
set / network-instance default protocols bgp router-id 10.0.0.2
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group prefixd peer-as 65010
set / network-instance default protocols bgp group prefixd transport local-address 10.0.0.2
set / network-instance default protocols bgp group prefixd afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp neighbor 10.0.0.1 peer-group prefixd
set / network-instance default protocols bgp neighbor 10.0.0.1 admin-state enable
