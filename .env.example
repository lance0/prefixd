# prefixd Environment Variables
# Copy this file to .env and customize for your deployment

# Optional: read inventory directly from configs/inventory.yaml for either speaker.
# See docs/tutorials/quickstart.md#host-managed-inventory before switching an existing deployment.
# COMPOSE_FILE=docker-compose.yml:docker-compose.inventory.yml

# =============================================================================
# Authentication
# =============================================================================

# There is no shared API token. Detectors and automation use named API tokens
# that prefixdctl mints in the controller service after the first start, for
# example:
#   docker compose exec prefixd-rustbgpd prefixdctl tokens create --name fnm-pop1 --scope ingest --source fastnetmon
# Each token is shown once. Store it with the client, never in this file.

# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://prefixd:your-secure-password@localhost:5432/prefixd

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=your-secure-password

# =============================================================================
# Frontend (Next.js Dashboard)
# =============================================================================

# Backend API URL (server-side only, used by Next.js API proxy)
# In Docker Compose, this is set automatically to http://prefixd:8080
# For local development outside Docker, set to http://localhost:8080
# PREFIXD_API=http://localhost:8080

# =============================================================================
# Image overrides
# =============================================================================

# Defaults are the tested image references in docker-compose.yml.
# PREFIXD_IMAGE=ghcr.io/lance0/prefixd:main
# PREFIXD_DASHBOARD_IMAGE=ghcr.io/lance0/prefixd-dashboard:main
# PREFIXD_RUSTBGPD_IMAGE=ghcr.io/lance0/rustbgpd:0.83.0@sha256:79a6a584b59dae0574a8f5240a4e8f68454fdfede1b7fe31ed446fcf92a30979
